{
  "extensions-gates": {
    "SessionStart": [
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy ensure",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy architecture",
        "timeout": 20
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy snapshot",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/agy-hook manifest agy gate",
            "timeout": 20
          }
        ],
        "matcher": "run_command|read_file|view_file|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content|invoke_subagent|define_subagent|manage_subagents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/agy-hook manifest agy ask",
            "timeout": 45
          }
        ],
        "matcher": "ask_question"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy prompt-architecture",
        "timeout": 20
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy touch",
        "timeout": 20
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy grist-sync",
        "timeout": 60
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy initialization",
        "timeout": 60
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy completion",
        "timeout": 90
      },
      {
        "type": "command",
        "command": "~/ai/scripts/bin/agy-hook manifest agy stop-notify",
        "timeout": 20
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/agy-hook manifest agy post-architecture",
            "timeout": 20
          }
        ],
        "matcher": "run_command"
      }
    ]
  }
}
