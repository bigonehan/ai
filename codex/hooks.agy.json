{
  "extensions-gates": {
    "SessionStart": [
      {"type": "command", "command": "~/ai/scripts/bin/agy-hook session-start", "timeout": 20}
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {"type": "command", "command": "~/ai/scripts/bin/agy-hook pre-command", "timeout": 20}
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {"type": "command", "command": "~/ai/scripts/bin/agy-hook pre-edit", "timeout": 20}
        ]
      },
      {
        "matcher": "ask_question",
        "hooks": [
          {"type": "command", "command": "~/ai/scripts/bin/agy-hook pre-ask", "timeout": 45}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {"type": "command", "command": "~/ai/scripts/bin/agy-hook post-command", "timeout": 20}
        ]
      }
    ],
    "Stop": [
      {"type": "command", "command": "~/ai/scripts/bin/agy-hook stop", "timeout": 90}
    ]
  }
}
