{
  "description": "Complete_task owns Stop and SubagentStop decisions. The main session ends when every current Table26 row has completion evidence and is 확인 or user-set 완료; a t26_<RawID> agent ends after its row reaches 검증. A main session with no registered rows is blocked once when files changed since its SessionStart snapshot.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tree/ai/scripts/bin/architecture-context",
            "timeout": 20,
            "statusMessage": "프로젝트 구조 확인"
          },
          {
            "type": "command",
            "command": "/home/tree/ai/scripts/bin/task-complete --session-start",
            "timeout": 20,
            "statusMessage": "세션 시작 스냅샷"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tree/ai/scripts/bin/architecture-context",
            "timeout": 20,
            "statusMessage": "요청 대상 구조 확인"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tree/ai/scripts/bin/task-complete",
            "timeout": 60,
            "statusMessage": "Grist 종료 조건 확인"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/tree/ai/scripts/bin/task-complete",
            "timeout": 60,
            "statusMessage": "Grist 담당 작업 제출 확인"
          }
        ]
      }
    ]
  }
}
