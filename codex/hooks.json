{
  "description": "Completion gate: the main session ends only when its Table26 rows are 대기/완료; a t26_<RawID> subagent only when its row is 검증/완료.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/tree/.codex/hooks/completion_gate.py",
            "timeout": 60,
            "statusMessage": "Grist 종료 조건 확인"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/tree/.codex/hooks/completion_gate.py",
            "timeout": 60,
            "statusMessage": "Grist 담당 작업 제출 확인"
          }
        ]
      }
    ]
  }
}
