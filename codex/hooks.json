{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/agent-rules ensure",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/architecture-context",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/task-complete --session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/main-edit-gate",
            "timeout": 20
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Bash|Agent|Task|exec_command|apply_patch|functions.exec_command|functions.apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/ask-notify",
            "timeout": 45
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/architecture-context",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/task-complete --session-touch",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/grist sync --cwd \"$PWD\" >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/initialization-gate",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/task-complete",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/ask-notify",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/ai/scripts/bin/architecture-context",
            "timeout": 20
          }
        ],
        "matcher": "Skill|Bash"
      }
    ]
  }
}
